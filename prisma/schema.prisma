generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Resource {
  id          Int      @id @default(autoincrement())
  title       String
  link        String
  description String   @default("")
  submittedBy String
  createdAt   DateTime @default(now())
}